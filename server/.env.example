# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# Point this at YOUR local database. Format:
#   postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ems
PG_POOL_MAX=10

# ─── JWT (Phase 4) ──────────────────────────────────────────────────────────
# Use long, random strings. Never reuse the same secret across environments.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-16-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Security ───────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── CORS ───────────────────────────────────────────────────────────────────
# The client dev-server origin (Vite default).
CORS_ORIGIN=http://localhost:5173

# ─── Public URL ─────────────────────────────────────────────────────────────
# Base URL used to build links to served uploads (avatars).
PUBLIC_URL=http://localhost:4000

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
