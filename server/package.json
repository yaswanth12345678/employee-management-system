{
  "name": "@ems/server",
  "version": "0.1.0",
  "private": true,
  "description": "EMS backend API (Express + PostgreSQL + TypeScript)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm --prefix ../shared run build",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm --prefix ../shared run build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "pretypecheck": "npm --prefix ../shared run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm --prefix ../shared run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@ems/shared": "file:../shared",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "employee-project-mgmt": "file:..",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "js-yaml": "^5.2.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
